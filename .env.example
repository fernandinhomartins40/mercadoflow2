# ============================================================
# MercadoFlow / PDV2Cloud — variaveis de ambiente obrigatorias
# Copie para .env (nao versionado) e preencha os valores.
# NUNCA versione o .env nem coloque valores reais neste arquivo.
# ============================================================

# --- Banco de dados ---
# Senha da role dona do schema (pdv2cloud): usada pelo Postgres, pelo Flyway e pelos jobs
DATABASE_ADMIN_PASSWORD=

# Role de aplicacao (sujeita a Row-Level Security; criada por scripts/db/setup-tenant-roles.sql)
DATABASE_APP_USER=pdv2cloud_app
DATABASE_APP_PASSWORD=

# --- JWT ---
# Segredo HS512 em base64 (minimo 64 bytes). Gere com:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# --- Seed de usuarios administrativos (perfil production) ---
# Se vazios, o seeder NAO cria os usuarios (crie manualmente depois).
ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD=

# --- VPS (docker-compose.vps.yml) ---
# POSTGRES_DB=pdv2cloud
# POSTGRES_USER=pdv2cloud
# POSTGRES_PASSWORD=
# DATABASE_URL=jdbc:postgresql://mercadoflow-postgres:5432/pdv2cloud
# DATABASE_USER=pdv2cloud_app
# DATABASE_PASSWORD=
# FLYWAY_USER=pdv2cloud
# FLYWAY_PASSWORD=
# CORS_ORIGIN=https://mercadoflow.com
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_NAME=
# VITE_API_URL=

# --- Stripe (cobranca de assinaturas) ---
# Deixe STRIPE_ENABLED=false para subir sem cobranca: o upgrade volta a ser
# manual no painel super admin. Guia completo em scripts/stripe/README.md
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
# Signing secret do endpoint em Developers > Webhooks (whsec_...)
STRIPE_WEBHOOK_SECRET=
# IDs de preco (price_...), nao de produto (prod_...)
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PROFISSIONAL=
